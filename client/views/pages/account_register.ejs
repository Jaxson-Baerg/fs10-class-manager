<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
  </head>
  <body class="container">

    <header id="header" class="fixed-top">
      <%- include('../partials/header'); %>
    </header>

    <main>
      <div class="jumbotron">
        <h1>Account Register</h1>
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="alert alert-danger mt-3" role="alert">
            <%= message %>
          </div>
        <% } %>
        <div class="row mt-5 justify-content-center">
          <div class="col-lg-10">
            <form action="/account/register" method="POST" class="input-form">
              <div class="row">
                <div class="col-md-6 form-group">
                  <input id="first_name" name="first_name" class="form-control" type="text" placeholder="Your First Name" value="<%= typeof form !== 'undefined' && form.first_name ? form.first_name : '' %>" required />
                </div>
                <div class="col-md-6 form-group">
                  <input id="last_name" name="last_name" class="form-control" type="text" placeholder="Your Last Name" value="<%= typeof form !== 'undefined' && form.last_name ? form.last_name : '' %>" required />
                </div>
              </div>
              <div class="form-group mt-3">
                <input id="email" name="email" class="form-control" type="email" placeholder="Your Email" value="<%= typeof form !== 'undefined' && form.email ? form.email : '' %>" required />
              </div>

              <input name="mailing_list" type="checkbox" <%= typeof form === 'undefined' || form.mailing_list ? 'checked' : '' %> />
              <label for="mailing_list">Sign up for my newsletter to recieve 1 free credit.</label>

              <% if (typeof captchaSiteKey !== 'undefined' && captchaSiteKey) { %>
                <div class="form-group mt-3 text-center">
                  <div class="g-recaptcha d-inline-block" data-sitekey="<%= captchaSiteKey %>"></div>
                </div>
              <% } %>

              <div class="text-center">
                <button type="submit">Register Account</button>
              </div>
            </form>
          </div>
        </div>
        <span>Already have an account? <a href="/account/login">Click here to login!</a></span>
      </div>
    </main>

    <footer>
      <%- include('../partials/footer'); %>
    </footer>

  </body>
</html>